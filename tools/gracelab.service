[Unit]
Description=GraceLab session management server
After=network.target

[Service]
Type=simple
User=gracelab-server
WorkingDirectory=/opt/gracelab/GraceLab/server
Environment=FLASK_ENV=production
# Generate a strong key: openssl rand -hex 32
# Store it in /etc/gracelab/server.env and reference it here, or set inline:
EnvironmentFile=-/etc/gracelab/server.env
# Fallback if EnvironmentFile is missing — replace before going live:
Environment=SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION

ExecStart=/opt/gracelab/GraceLab/server/venv/bin/gunicorn \
    -w 1 \
    -b 127.0.0.1:5000 \
    --access-logfile /var/log/gracelab/access.log \
    --error-logfile  /var/log/gracelab/error.log \
    app:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
