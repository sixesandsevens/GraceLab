[Desktop Entry]
Type=Application
Name=GraceLab Lockdown
Comment=Enforce kiosk restrictions at session start
Exec=bash -c 'sleep 5; xfconf-query -c xfce4-desktop -p /desktop-menu/show -n -t bool -s false 2>/dev/null || true; xfconf-query -c xfce4-desktop -p /desktop-menu/show -t bool -s false 2>/dev/null || true; xfconf-query -c xfce4-desktop -p /windowlist-menu/show -n -t bool -s false 2>/dev/null || true; xfconf-query -c xfce4-desktop -p /windowlist-menu/show -t bool -s false 2>/dev/null || true'
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=0
Hidden=false
NoDisplay=true
