[server]
url = http://192.168.1.50:5000

[station]
hostname = LAB-PC-01
token = replace-with-station-token

[session]
warning_minutes = 5
heartbeat_interval_seconds = 30
# How often to poll /api/session/status during an active session.
# Determines how quickly staff extend/end actions reach the workstation.
sync_interval_seconds = 12

[paths]
# Production install paths (requires sudoers entry for gracelab user)
# start_script  = sudo /opt/gracelab-client/current/scripts/start_guest_session.sh
# end_script    = sudo /opt/gracelab-client/current/scripts/end_guest_session.sh
# reset_script  = sudo /opt/gracelab-client/current/scripts/reset_guest_home.sh
# session_state = /var/lib/gracelab-client/session-state.json
# enable_admin_override_script  = sudo /opt/gracelab-client/current/scripts/enable_admin_override.sh
# disable_admin_override_script = sudo /opt/gracelab-client/current/scripts/disable_admin_override.sh
# reboot_script                 = sudo /opt/gracelab-client/current/scripts/reboot_station.sh
#
# For local dev/testing — point at the repo scripts directory:
start_script = scripts/start_guest_session.sh
end_script   = scripts/end_guest_session.sh
reset_script = scripts/reset_guest_home.sh

[ui]
# Fullscreen mode. Set to false for windowed testing.
fullscreen = true
# Organization name shown on the idle screen (overridden by server config if reachable)
organization_name = Grace Marketplace

[updates]
# Whether the client will check for and install updates.
enabled = true
# stable or beta
channel = stable
# How often to check for updates (seconds). Only checked from IDLE state.
check_interval_seconds = 300
# disabled | manual | idle_only | force
# idle_only/manual always wait for the station to be idle, including updates
# queued from the admin dashboard. Only "force" installs during an active
# session — set it per-station only if you specifically need that.
install_policy = idle_only

[maintenance]
# Local Linux administrator account switched to when maintenance mode is
# entered (see README "Two OS users on each station" — this is a third,
# separately-provisioned account, distinct from gracelab and guestlab).
# Leave blank if you haven't provisioned one yet; maintenance mode falls
# back to the LightDM greeter, which still lets an operator authenticate
# normally. GraceLab never stores or checks this account's password.
admin_user =
